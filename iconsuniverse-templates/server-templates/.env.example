# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://user:pass@cluster0.qlmyfit.mongodb.net/iconsuniverse

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Third-Party Services
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

RAZORPAY_KEY_ID=replace-me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

MSG91_AUTH_KEY=replace-me
MSG91_SENDER_ID=replace-me

NODEMAILER_EMAIL=no-reply@iconsuniverse.com
NODEMAILER_PASS=replace-me

# Frontend (Vite — must be prefixed VITE_)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=replace-me
CLIENT_URL=http://localhost:5173
